{
  "Comment": "Radio Player State Machine - Controls player state transitions and command orchestration",
  "StartAt": "ParseCommand",
  "States": {
    "ParseCommand": {
      "Type": "Pass",
      "Comment": "Extract command details from IoT message",
      "Parameters": {
        "command.$": "$.command",
        "playerId.$": "$.playerId",
        "timestamp.$": "$.timestamp"
      },
      "Next": "RouteCommand"
    },
    
    "RouteCommand": {
      "Type": "Choice",
      "Comment": "Route to appropriate handler based on command type",
      "Choices": [
        {
          "Variable": "$.command",
          "StringEquals": "LOAD",
          "Next": "HandleLoadCommand"
        },
        {
          "Variable": "$.command",
          "StringEquals": "PLAY",
          "Next": "HandlePlayCommand"
        },
        {
          "Variable": "$.command",
          "StringEquals": "PAUSE",
          "Next": "HandlePauseCommand"
        },
        {
          "Variable": "$.command",
          "StringEquals": "STOP",
          "Next": "HandleStopCommand"
        },
        {
          "Variable": "$.command",
          "StringEquals": "UNLOAD",
          "Next": "HandleUnloadCommand"
        }
      ],
      "Default": "UnknownCommand"
    },
    
    "HandleLoadCommand": {
      "Type": "Task",
      "Comment": "Process LOAD command - fetch playlist and track data",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${LoadCommandHandlerArn}",
        "Payload": {
          "command.$": "$.command",
          "playerId.$": "$.playerId",
          "timestamp.$": "$.timestamp"
        }
      },
      "ResultPath": "$.loadResult",
      "Next": "ValidateLoadResult",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError",
          "ResultPath": "$.error"
        }
      ]
    },
    
    "ValidateLoadResult": {
      "Type": "Choice",
      "Comment": "Check if track data was successfully loaded",
      "Choices": [
        {
          "Variable": "$.loadResult.Payload.success",
          "BooleanEquals": true,
          "Next": "PublishLoadResponse"
        }
      ],
      "Default": "HandleError"
    },
    
    "PublishLoadResponse": {
      "Type": "Task",
      "Comment": "Publish LOAD command response with track data to IoT",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PublishIoTCommandArn}",
        "Payload": {
          "topic.$": "States.Format('radio/player/{}/command', $.playerId)",
          "message": {
            "command": "LOAD",
            "playerId.$": "$.playerId",
            "timestamp.$": "$$.State.EnteredTime",
            "params": {
              "playlistId.$": "$.loadResult.Payload.playlistId",
              "track.$": "$.loadResult.Payload.track"
            }
          }
        }
      },
      "ResultPath": "$.publishResult",
      "Next": "CommandSuccess"
    },
    
    "HandlePlayCommand": {
      "Type": "Task",
      "Comment": "Process PLAY command - validate state and respond",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PlayCommandHandlerArn}",
        "Payload": {
          "command.$": "$.command",
          "playerId.$": "$.playerId"
        }
      },
      "ResultPath": "$.playResult",
      "Next": "PublishPlayResponse",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError",
          "ResultPath": "$.error"
        }
      ]
    },
    
    "PublishPlayResponse": {
      "Type": "Task",
      "Comment": "Publish PLAY command response to IoT",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PublishIoTCommandArn}",
        "Payload": {
          "topic.$": "States.Format('radio/player/{}/command', $.playerId)",
          "message": {
            "command": "PLAY",
            "playerId.$": "$.playerId",
            "timestamp.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": "$.publishResult",
      "Next": "CommandSuccess"
    },
    
    "HandlePauseCommand": {
      "Type": "Task",
      "Comment": "Process PAUSE command",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SimpleCommandHandlerArn}",
        "Payload": {
          "command": "PAUSE",
          "playerId.$": "$.playerId"
        }
      },
      "ResultPath": "$.result",
      "Next": "PublishSimpleResponse",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError",
          "ResultPath": "$.error"
        }
      ]
    },
    
    "HandleStopCommand": {
      "Type": "Task",
      "Comment": "Process STOP command",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SimpleCommandHandlerArn}",
        "Payload": {
          "command": "STOP",
          "playerId.$": "$.playerId"
        }
      },
      "ResultPath": "$.result",
      "Next": "PublishSimpleResponse",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError",
          "ResultPath": "$.error"
        }
      ]
    },
    
    "HandleUnloadCommand": {
      "Type": "Task",
      "Comment": "Process UNLOAD command",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SimpleCommandHandlerArn}",
        "Payload": {
          "command": "UNLOAD",
          "playerId.$": "$.playerId"
        }
      },
      "ResultPath": "$.result",
      "Next": "PublishSimpleResponse",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleError",
          "ResultPath": "$.error"
        }
      ]
    },
    
    "PublishSimpleResponse": {
      "Type": "Task",
      "Comment": "Publish simple command response (PAUSE/STOP/UNLOAD) to IoT",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PublishIoTCommandArn}",
        "Payload": {
          "topic.$": "States.Format('radio/player/{}/command', $.playerId)",
          "message": {
            "command.$": "$.result.Payload.command",
            "playerId.$": "$.playerId",
            "timestamp.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": "$.publishResult",
      "Next": "CommandSuccess"
    },
    
    "UnknownCommand": {
      "Type": "Fail",
      "Comment": "Unknown command type received",
      "Error": "UnknownCommandError",
      "Cause": "The command type is not recognized by the state machine"
    },
    
    "HandleError": {
      "Type": "Task",
      "Comment": "Handle errors and publish error response to IoT",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PublishIoTCommandArn}",
        "Payload": {
          "topic.$": "States.Format('radio/player/{}/command', $.playerId)",
          "message": {
            "command": "ERROR",
            "playerId.$": "$.playerId",
            "timestamp.$": "$$.State.EnteredTime",
            "error": {
              "message.$": "$.error.Cause",
              "originalCommand.$": "$.command"
            }
          }
        }
      },
      "ResultPath": "$.errorPublishResult",
      "Next": "CommandFailed"
    },
    
    "CommandSuccess": {
      "Type": "Succeed",
      "Comment": "Command processed successfully"
    },
    
    "CommandFailed": {
      "Type": "Fail",
      "Comment": "Command processing failed",
      "Error": "CommandProcessingError",
      "Cause": "Failed to process player command"
    }
  }
}
