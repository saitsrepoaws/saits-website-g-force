# AWS IoT Configuration
# Get your endpoint from: AWS Console → IoT Core → Settings → Device data endpoint
VITE_AWS_IOT_ENDPOINT=your-iot-endpoint-ats.iot.region.amazonaws.com

# AWS Region
VITE_AWS_REGION=eu-west-1

# Media Base URL (for audio files and cover art)
# Leave empty to serve from same origin (default)
# Or set to S3 bucket URL: https://your-bucket.s3.region.amazonaws.com
VITE_MEDIA_BASE_URL=
