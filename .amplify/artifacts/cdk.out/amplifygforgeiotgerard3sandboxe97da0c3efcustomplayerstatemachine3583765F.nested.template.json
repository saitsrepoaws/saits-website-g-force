  "PlayerStateMachineDF3FE3FD": {
   "Type": "AWS::StepFunctions::StateMachine",
   "Properties": {
    "DefinitionString": {
     "Fn::Join": [
      "",
      [
       "{\n  \"Comment\": \"Radio Player State Machine - Controls player state transitions and command orchestration\",\n  \"StartAt\": \"ParseCommand\",\n  \"States\": {\n    \"ParseCommand\": {\n      \"Type\": \"Pass\",\n      \"Comment\": \"Extract command details from IoT message\",\n      \"Parameters\": {\n        \"command.$\": \"$.command\",\n        \"playerId.$\": \"$.playerId\",\n        \"timestamp.$\": \"$.timestamp\"\n      },\n      \"Next\": \"RouteCommand\"\n    },\n    \n    \"RouteCommand\": {\n      \"Type\": \"Choice\",\n      \"Comment\": \"Route to appropriate handler based on command type\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.command\",\n          \"StringEquals\": \"LOAD\",\n          \"Next\": \"HandleLoadCommand\"\n        },\n        {\n          \"Variable\": \"$.command\",\n          \"StringEquals\": \"PLAY\",\n          \"Next\": \"HandlePlayCommand\"\n        },\n        {\n          \"Variable\": \"$.command\",\n          \"StringEquals\": \"PAUSE\",\n          \"Next\": \"HandlePauseCommand\"\n        },\n        {\n          \"Variable\": \"$.command\",\n          \"StringEquals\": \"STOP\",\n          \"Next\": \"HandleStopCommand\"\n        },\n        {\n          \"Variable\": \"$.command\",\n          \"StringEquals\": \"UNLOAD\",\n          \"Next\": \"HandleUnloadCommand\"\n        }\n      ],\n      \"Default\": \"UnknownCommand\"\n    },\n    \n    \"HandleLoadCommand\": {\n      \"Type\": \"Task\",\n      \"Comment\": \"Process LOAD command - fetch playlist and track data\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"",
       {
        "Ref": "referencetoamplifygforgeiotgerard3sandboxe97da0c3effunctionNestedStackfunctionNestedStackResource89931112Outputsamplifygforgeiotgerard3sandboxe97da0c3effunctionplayerloadhandlerlambda8DE09149Arn"
       },
       "\",\n        \"Payload\": {\n          \"command.$\": \"$.command\",\n          \"playerId.$\": \"$.playerId\",\n          \"timestamp.$\": \"$.timestamp\"\n        }\n      },\n      \"ResultPath\": \"$.loadResult\",\n      \"Next\": \"ValidateLoadResult\",\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"Next\": \"HandleError\",\n          \"ResultPath\": \"$.error\"\n        }\n      ]\n    },\n    \n    \"ValidateLoadResult\": {\n      \"Type\": \"Choice\",\n      \"Comment\": \"Check if track data was successfully loaded\",\n      \"Choices\": [\n        {\n          \"Variable\": \"$.loadResult.Payload.success\",\n          \"BooleanEquals\": true,\n          \"Next\": \"PublishLoadResponse\"\n        }\n      ],\n      \"Default\": \"HandleError\"\n    },\n    \n    \"PublishLoadResponse\": {\n      \"Type\": \"Task\",\n      \"Comment\": \"Publish LOAD command response with track data to IoT via Lambda\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"",
       {
        "Ref": "referencetoamplifygforgeiotgerard3sandboxe97da0c3effunctionNestedStackfunctionNestedStackResource89931112Outputsamplifygforgeiotgerard3sandboxe97da0c3effunctionplayeriotpublisherlambda4B735D22Arn"
       },
       "\",\n        \"Payload\": {\n          \"topic.$\": \"States.Format('radio/player/{}/command', $.playerId)\",\n          \"message\": {\n            \"command\": \"LOAD\",\n            \"playerId.$\": \"$.playerId\",\n            \"timestamp.$\": \"$$.State.EnteredTime\",\n            \"params\": {\n              \"playlist.$\": \"$.loadResult.Payload.playlist\",\n              \"schedule.$\": \"$.loadResult.Payload.schedule\",\n              \"currentTrack.$\": \"$.loadResult.Payload.currentTrack\",\n              \"track.$\": \"$.loadResult.Payload.track\"\n            }\n          }\n        }\n      },\n      \"ResultPath\": \"$.publishResult\",\n      \"Next\": \"CommandSuccess\",\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"Next\": \"HandleError\",\n          \"ResultPath\": \"$.error\"\n        }\n      ]\n    },\n    \n    \"HandlePlayCommand\": {\n      \"Type\": \"Task\",\n      \"Comment\": \"Process PLAY command - validate state and respond\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"",
       {
        "Ref": "referencetoamplifygforgeiotgerard3sandboxe97da0c3effunctionNestedStackfunctionNestedStackResource89931112Outputsamplifygforgeiotgerard3sandboxe97da0c3effunctionplayersimplehandlerlambdaF59E518EArn"
       },
       "\",\n        \"Payload\": {\n          \"command.$\": \"$.command\",\n          \"playerId.$\": \"$.playerId\"\n        }\n      },\n      \"ResultPath\": \"$.playResult\",\n      \"Next\": \"PublishPlayResponse\",\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"Next\": \"HandleError\",\n          \"ResultPath\": \"$.error\"\n        }\n      ]\n    },\n    \n    \"PublishPlayResponse\": {\n      \"Type\": \"Task\",\n      \"Comment\": \"Publish PLAY command response to IoT\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"",
       {
        "Ref": "referencetoamplifygforgeiotgerard3sandboxe97da0c3effunctionNestedStackfunctionNestedStackResource89931112Outputsamplifygforgeiotgerard3sandboxe97da0c3effunctionplayeriotpublisherlambda4B735D22Arn"
       },
       "\",\n        \"Payload\": {\n          \"topic.$\": \"States.Format('radio/player/{}/command', $.playerId)\",\n          \"message\": {\n            \"command\": \"PLAY\",\n            \"playerId.$\": \"$.playerId\",\n            \"timestamp.$\": \"$$.State.EnteredTime\"\n          }\n        }\n      },\n      \"ResultPath\": \"$.publishResult\",\n      \"Next\": \"CommandSuccess\"\n    },\n    \n    \"HandlePauseCommand\": {\n      \"Type\": \"Task\",\n      \"Comment\": \"Process PAUSE command\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"",
       {
        "Ref": "referencetoamplifygforgeiotgerard3sandboxe97da0c3effunctionNestedStackfunctionNestedStackResource89931112Outputsamplifygforgeiotgerard3sandboxe97da0c3effunctionplayersimplehandlerlambdaF59E518EArn"
       },
       "\",\n        \"Payload\": {\n          \"command\": \"PAUSE\",\n          \"playerId.$\": \"$.playerId\"\n        }\n      },\n      \"ResultPath\": \"$.result\",\n      \"Next\": \"PublishSimpleResponse\",\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"Next\": \"HandleError\",\n          \"ResultPath\": \"$.error\"\n        }\n      ]\n    },\n    \n    \"HandleStopCommand\": {\n      \"Type\": \"Task\",\n      \"Comment\": \"Process STOP command\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"",
       {
        "Ref": "referencetoamplifygforgeiotgerard3sandboxe97da0c3effunctionNestedStackfunctionNestedStackResource89931112Outputsamplifygforgeiotgerard3sandboxe97da0c3effunctionplayersimplehandlerlambdaF59E518EArn"
       },
       "\",\n        \"Payload\": {\n          \"command\": \"STOP\",\n          \"playerId.$\": \"$.playerId\"\n        }\n      },\n      \"ResultPath\": \"$.result\",\n      \"Next\": \"PublishSimpleResponse\",\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"Next\": \"HandleError\",\n          \"ResultPath\": \"$.error\"\n        }\n      ]\n    },\n    \n    \"HandleUnloadCommand\": {\n      \"Type\": \"Task\",\n      \"Comment\": \"Process UNLOAD command\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"",
       {
        "Ref": "referencetoamplifygforgeiotgerard3sandboxe97da0c3effunctionNestedStackfunctionNestedStackResource89931112Outputsamplifygforgeiotgerard3sandboxe97da0c3effunctionplayersimplehandlerlambdaF59E518EArn"
       },
       "\",\n        \"Payload\": {\n          \"command\": \"UNLOAD\",\n          \"playerId.$\": \"$.playerId\"\n        }\n      },\n      \"ResultPath\": \"$.result\",\n      \"Next\": \"PublishSimpleResponse\",\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"States.ALL\"],\n          \"Next\": \"HandleError\",\n          \"ResultPath\": \"$.error\"\n        }\n      ]\n    },\n    \n    \"PublishSimpleResponse\": {\n      \"Type\": \"Task\",\n      \"Comment\": \"Publish simple command response (PAUSE/STOP/UNLOAD) to IoT\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"",
       {
        "Ref": "referencetoamplifygforgeiotgerard3sandboxe97da0c3effunctionNestedStackfunctionNestedStackResource89931112Outputsamplifygforgeiotgerard3sandboxe97da0c3effunctionplayeriotpublisherlambda4B735D22Arn"
       },
       "\",\n        \"Payload\": {\n          \"topic.$\": \"States.Format('radio/player/{}/command', $.playerId)\",\n          \"message\": {\n            \"command.$\": \"$.result.Payload.command\",\n            \"playerId.$\": \"$.playerId\",\n            \"timestamp.$\": \"$$.State.EnteredTime\"\n          }\n        }\n      },\n      \"ResultPath\": \"$.publishResult\",\n      \"Next\": \"CommandSuccess\"\n    },\n    \n    \"UnknownCommand\": {\n      \"Type\": \"Fail\",\n      \"Comment\": \"Unknown command type received\",\n      \"Error\": \"UnknownCommandError\",\n      \"Cause\": \"The command type is not recognized by the state machine\"\n    },\n    \n    \"HandleError\": {\n      \"Type\": \"Task\",\n      \"Comment\": \"Handle errors and publish error response to IoT\",\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Parameters\": {\n        \"FunctionName\": \"",
       {
        "Ref": "referencetoamplifygforgeiotgerard3sandboxe97da0c3effunctionNestedStackfunctionNestedStackResource89931112Outputsamplifygforgeiotgerard3sandboxe97da0c3effunctionplayeriotpublisherlambda4B735D22Arn"
       },
       "\",\n        \"Payload\": {\n          \"topic.$\": \"States.Format('radio/player/{}/command', $.playerId)\",\n          \"message\": {\n            \"command\": \"ERROR\",\n            \"playerId.$\": \"$.playerId\",\n            \"timestamp.$\": \"$$.State.EnteredTime\",\n            \"error\": {\n              \"message.$\": \"$.error.Cause\",\n              \"originalCommand.$\": \"$.command\"\n            }\n          }\n        }\n      },\n      \"ResultPath\": \"$.errorPublishResult\",\n      \"Next\": \"CommandFailed\"\n    },\n    \n    \"CommandSuccess\": {\n      \"Type\": \"Succeed\",\n      \"Comment\": \"Command processed successfully\"\n    },\n    \n    \"CommandFailed\": {\n      \"Type\": \"Fail\",\n      \"Comment\": \"Command processing failed\",\n      \"Error\": \"CommandProcessingError\",\n      \"Cause\": \"Failed to process player command\"\n    }\n  }\n}\n"
      ]
     ]
    },
