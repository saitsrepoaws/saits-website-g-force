#!/bin/bash
################################################################################
# 🚀 G-FORGE RADIO - STREAM SERVER DEPLOYMENT
################################################################################
# Purpose: Branch-based deployment to AWS CodeDeploy
# Usage: ./deploy_streamserver <branch-name>
# Examples:
#   ./deploy_streamserver main         → production
#   ./deploy_streamserver development  → development
#   ./deploy_streamserver gerard       → gerard sandbox
################################################################################

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

BRANCH="${1:-$(git rev-parse --abbrev-ref HEAD)}"
REGION="eu-west-1"

# Environment mapping
case "$BRANCH" in
  main|master)
    ENVIRONMENT="production"
    ;;
  development|develop)
    ENVIRONMENT="development"
    ;;
  *)
    # Feature branches or personal branches
    ENVIRONMENT=$(echo "$BRANCH" | sed 's/\//-/g' | tr '[:upper:]' '[:lower:]')
    ;;
esac

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "${BLUE}🚀 G-FORGE RADIO STREAM SERVER DEPLOYMENT${NC}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo -e "${GREEN}Branch:${NC}      $BRANCH"
echo -e "${GREEN}Environment:${NC} $ENVIRONMENT"
echo -e "${GREEN}Region:${NC}      $REGION"
echo ""

# Validate branch
if [ -z "$BRANCH" ]; then
  echo -e "${RED}❌ No branch specified!${NC}"
  echo "Usage: ./deploy_streamserver <branch-name>"
  exit 1
fi

# Check if we're in git repo
if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo -e "${RED}❌ Not in a git repository!${NC}"
  exit 1
fi

# Get current commit
COMMIT_SHA=$(git rev-parse --short HEAD)
COMMIT_MSG=$(git log -1 --pretty=%B | head -1)
echo -e "${GREEN}Commit:${NC}      $COMMIT_SHA - $COMMIT_MSG"
echo ""

# Check for uncommitted changes
if [ -n "$(git status --porcelain)" ]; then
  echo -e "${YELLOW}⚠️  Warning: You have uncommitted changes!${NC}"
  echo -e "${YELLOW}   Consider committing before deployment${NC}"
  echo ""
  read -p "Continue anyway? (y/n) " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Deployment cancelled."
    exit 1
  fi
fi

# Load environment-specific parameters from Parameter Store
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📋 Loading Parameters from AWS Parameter Store..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

PARAM_PATH="/g-forge-radio/${ENVIRONMENT}"

# Check if parameters exist
if ! aws ssm get-parameters-by-path \
  --path "$PARAM_PATH" \
  --region "$REGION" \
  --query 'Parameters[0]' \
  --output text > /dev/null 2>&1; then
  
  echo -e "${YELLOW}⚠️  No parameters found for environment: $ENVIRONMENT${NC}"
  echo -e "${YELLOW}   Creating new environment stack...${NC}"
  echo ""
  
  # Create basic parameters for new environment
  ./pipeline/scripts/create-environment-stack.sh "$ENVIRONMENT"
fi

# Get deployment parameters
INSTANCE_ID=$(aws ssm get-parameter \
  --name "${PARAM_PATH}/ec2/instance-id" \
  --region "$REGION" \
  --query 'Parameter.Value' \
  --output text 2>/dev/null || echo "")

APP_NAME=$(aws ssm get-parameter \
  --name "${PARAM_PATH}/codedeploy/application-name" \
  --region "$REGION" \
  --query 'Parameter.Value' \
  --output text 2>/dev/null || echo "g-forge-radio")

DEPLOYMENT_GROUP=$(aws ssm get-parameter \
  --name "${PARAM_PATH}/codedeploy/deployment-group" \
  --region "$REGION" \
  --query 'Parameter.Value' \
  --output text 2>/dev/null || echo "radio-${ENVIRONMENT}")

S3_BUCKET=$(aws ssm get-parameter \
  --name "${PARAM_PATH}/s3/deployment-bucket" \
  --region "$REGION" \
  --query 'Parameter.Value' \
  --output text 2>/dev/null || echo "g-forge-radio-deployments-035636364722")

echo -e "${GREEN}✅ Parameters loaded:${NC}"
echo "   Instance ID:       ${INSTANCE_ID:-<not deployed yet>}"
echo "   Application:       $APP_NAME"
echo "   Deployment Group:  $DEPLOYMENT_GROUP"
echo "   S3 Bucket:         $S3_BUCKET"
echo ""

# Create deployment artifact
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📦 Creating Deployment Artifact..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
ARTIFACT_NAME="g-forge-radio-${ENVIRONMENT}-${COMMIT_SHA}-${TIMESTAMP}.zip"
ARTIFACT_PATH="/tmp/${ARTIFACT_NAME}"

echo "Creating: $ARTIFACT_NAME"

# Create deployment info file
cat > /tmp/deployment-info.json << EOF
{
  "environment": "$ENVIRONMENT",
  "branch": "$BRANCH",
  "commit": "$COMMIT_SHA",
  "timestamp": "$TIMESTAMP",
  "deployedBy": "$(git config user.name)",
  "commitMessage": "$COMMIT_MSG"
}
EOF

# Add deployment info to artifact
zip -q "$ARTIFACT_PATH" /tmp/deployment-info.json

# Package application
zip -r "$ARTIFACT_PATH" . \
  -x "*.git/*" \
  -x "node_modules/*" \
  -x ".amplify/*" \
  -x "dist/*" \
  -x "*.log" \
  -x "*.zip" \
  -x ".DS_Store" \
  -q

SIZE=$(du -h "$ARTIFACT_PATH" | cut -f1)
echo -e "${GREEN}✅ Artifact created:${NC} $SIZE"
echo ""

# Upload to S3
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📤 Uploading to S3..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

aws s3 cp "$ARTIFACT_PATH" \
  "s3://${S3_BUCKET}/${ENVIRONMENT}/${ARTIFACT_NAME}" \
  --region "$REGION"

echo -e "${GREEN}✅ Uploaded to S3${NC}"
echo ""

# Create deployment
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🚀 Creating CodeDeploy Deployment..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

DEPLOYMENT_ID=$(aws deploy create-deployment \
  --application-name "$APP_NAME" \
  --deployment-group-name "$DEPLOYMENT_GROUP" \
  --s3-location "bucket=${S3_BUCKET},key=${ENVIRONMENT}/${ARTIFACT_NAME},bundleType=zip" \
  --description "Branch: $BRANCH | Commit: $COMMIT_SHA | $COMMIT_MSG" \
  --region "$REGION" \
  --query 'deploymentId' \
  --output text)

echo -e "${GREEN}✅ Deployment created:${NC} $DEPLOYMENT_ID"
echo ""

# Save deployment ID to parameter store
aws ssm put-parameter \
  --name "${PARAM_PATH}/deployment/latest-deployment-id" \
  --value "$DEPLOYMENT_ID" \
  --type "String" \
  --overwrite \
  --region "$REGION" > /dev/null

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "${GREEN}✅ DEPLOYMENT STARTED!${NC}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo -e "${BLUE}Deployment Details:${NC}"
echo "  Environment:    $ENVIRONMENT"
echo "  Branch:         $BRANCH"
echo "  Commit:         $COMMIT_SHA"
echo "  Deployment ID:  $DEPLOYMENT_ID"
echo "  Artifact:       $ARTIFACT_NAME"
echo ""
echo -e "${BLUE}Monitor deployment:${NC}"
echo "  AWS Console:    https://eu-west-1.console.aws.amazon.com/codesuite/codedeploy/deployments/$DEPLOYMENT_ID"
echo "  CLI:            aws deploy get-deployment --deployment-id $DEPLOYMENT_ID --region $REGION"
echo ""
echo -e "${YELLOW}⏱️  Deployment typically takes 20-30 minutes${NC}"
echo ""

# Offer to monitor
read -p "Monitor deployment progress? (y/n) " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
  echo ""
  echo "Monitoring deployment (press Ctrl+C to stop)..."
  echo ""
  
  for i in {1..120}; do
    STATUS=$(aws deploy get-deployment \
      --deployment-id "$DEPLOYMENT_ID" \
      --region "$REGION" \
      --query 'deploymentInfo.status' \
      --output text)
    
    TIMESTAMP=$(date +%H:%M:%S)
    echo "  [$TIMESTAMP] Status: $STATUS"
    
    if [ "$STATUS" = "Succeeded" ]; then
      echo ""
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo -e "${GREEN}✅ DEPLOYMENT SUCCESSFUL!${NC}"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      echo ""
      exit 0
    elif [ "$STATUS" = "Failed" ] || [ "$STATUS" = "Stopped" ]; then
      echo ""
      echo -e "${RED}❌ DEPLOYMENT FAILED!${NC}"
      echo ""
      aws deploy get-deployment \
        --deployment-id "$DEPLOYMENT_ID" \
        --region "$REGION" \
        --query 'deploymentInfo.errorInformation'
      exit 1
    fi
    
    sleep 30
  done
fi

echo ""
echo -e "${GREEN}✅ Deployment monitoring stopped${NC}"
echo "   Deployment is still running in background"
echo ""

# Cleanup
rm -f "$ARTIFACT_PATH" /tmp/deployment-info.json

exit 0
