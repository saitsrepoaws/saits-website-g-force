{
  "name": "gforge-codedeploy-pipeline",
  "version": "1.0.0",
  "description": "G-Forge Radio - Standalone CI/CD Pipeline with CodePipeline & CodeDeploy",
  "private": true,
  "scripts": {
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all --require-approval never",
    "deploy:pipeline": "cdk deploy GForgePipelineStack",
    "deploy:staging": "cdk deploy GForgeStagingStack",
    "deploy:prod": "cdk deploy GForgeProductionStack",
    "destroy": "cdk destroy --all",
    "watch": "cdk watch",
    "test": "jest",
    "bootstrap": "cdk bootstrap",
    "validate": "cdk synth --validation"
  },
  "keywords": [
    "aws",
    "cdk",
    "codepipeline",
    "codedeploy",
    "ci-cd",
    "amplify"
  ],
  "author": "Gerard + Cascade AI",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.22",
    "aws-cdk": "^2.220.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.3.0"
  }
}
