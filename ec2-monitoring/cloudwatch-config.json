{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/tmp/liquidsoap.log",
            "log_group_name": "/splash-fm/liquidsoap",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 7,
            "timezone": "Local"
          },
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/splash-fm/nginx",
            "log_stream_name": "{instance_id}-access",
            "retention_in_days": 14,
            "timezone": "Local"
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/splash-fm/nginx",
            "log_stream_name": "{instance_id}-error",
            "retention_in_days": 14,
            "timezone": "Local"
          },
          {
            "file_path": "/var/log/icecast2/access.log",
            "log_group_name": "/splash-fm/icecast",
            "log_stream_name": "{instance_id}-access",
            "retention_in_days": 7,
            "timezone": "Local"
          },
          {
            "file_path": "/var/log/icecast2/error.log",
            "log_group_name": "/splash-fm/icecast",
            "log_stream_name": "{instance_id}-error",
            "retention_in_days": 7,
            "timezone": "Local"
          },
          {
            "file_path": "/var/log/splash-health.log",
            "log_group_name": "/splash-fm/health",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30,
            "timezone": "Local"
          },
          {
            "file_path": "/var/log/splash-watchdog.log",
            "log_group_name": "/splash-fm/watchdog",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30,
            "timezone": "Local"
          },
          {
            "file_path": "/var/log/splash-silence.log",
            "log_group_name": "/splash-fm/silence-detection",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 30,
            "timezone": "Local"
          },
          {
            "file_path": "/tmp/stereotool.log",
            "log_group_name": "/splash-fm/stereotool",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 7,
            "timezone": "Local"
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "SplashFM",
    "metrics_collected": {
      "cpu": {
        "measurement": [
          {
            "name": "cpu_usage_idle",
            "rename": "CPU_IDLE",
            "unit": "Percent"
          },
          {
            "name": "cpu_usage_iowait",
            "rename": "CPU_IOWAIT",
            "unit": "Percent"
          }
        ],
        "metrics_collection_interval": 60,
        "totalcpu": false
      },
      "disk": {
        "measurement": [
          {
            "name": "used_percent",
            "rename": "DISK_USED",
            "unit": "Percent"
          },
          {
            "name": "inodes_free",
            "rename": "DISK_INODES_FREE",
            "unit": "Count"
          }
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "/"
        ]
      },
      "diskio": {
        "measurement": [
          {
            "name": "io_time",
            "rename": "DISK_IO_TIME",
            "unit": "Milliseconds"
          },
          {
            "name": "write_bytes",
            "rename": "DISK_WRITE_BYTES",
            "unit": "Bytes"
          },
          {
            "name": "read_bytes",
            "rename": "DISK_READ_BYTES",
            "unit": "Bytes"
          }
        ],
        "metrics_collection_interval": 60
      },
      "mem": {
        "measurement": [
          {
            "name": "mem_used_percent",
            "rename": "MEM_USED",
            "unit": "Percent"
          }
        ],
        "metrics_collection_interval": 60
      },
      "netstat": {
        "measurement": [
          {
            "name": "tcp_established",
            "rename": "TCP_CONNECTIONS",
            "unit": "Count"
          },
          {
            "name": "tcp_time_wait",
            "rename": "TCP_TIME_WAIT",
            "unit": "Count"
          }
        ],
        "metrics_collection_interval": 60
      },
      "swap": {
        "measurement": [
          {
            "name": "swap_used_percent",
            "rename": "SWAP_USED",
            "unit": "Percent"
          }
        ],
        "metrics_collection_interval": 60
      }
    }
  }
}
